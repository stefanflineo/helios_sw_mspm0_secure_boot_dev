{
  "version": "0.2.0",
  "configurations": [
        {
      "name": "Debug MSPM0L1117 - J-Link",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "MSPM0L1117",
      "interface": "swd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/customer_secure_code.out",
      "runToEntryPoint": "main",
      "preLaunchTask": "CMake build",

      "armToolchainPath": "C:/Program Files/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin"
    },
    {
      "name": "Debug MSPM0L1117 - XDS110/OpenOCD",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/customer_secure_code.out",
      "runToEntryPoint": "main",
      "preLaunchTask": "CMake build",
      "configFiles": [
        "interface/xds110.cfg",
        "target/ti_mspm0.cfg"
      ]
    }
  ]
}
